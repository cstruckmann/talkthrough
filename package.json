{
  "name": "talkthrough",
  "displayName": "Talkthrough",
  "description": "Voice-narrated walkthroughs of AI agent code changes, inside VS Code.",
  "version": "0.0.1",
  "publisher": "cstruckmann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cstruckmann/talkthrough.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "talkthrough.explainChanges",
        "title": "Explain recent changes",
        "category": "Talkthrough"
      },
      {
        "command": "talkthrough.setApiKey",
        "title": "Set API key",
        "category": "Talkthrough"
      },
      {
        "command": "talkthrough.nextSegment",
        "title": "Next segment",
        "category": "Talkthrough",
        "icon": "$(chevron-right)"
      },
      {
        "command": "talkthrough.previousSegment",
        "title": "Previous segment",
        "category": "Talkthrough",
        "icon": "$(chevron-left)"
      },
      {
        "command": "talkthrough.goToSegment",
        "title": "Go to segment\u2026",
        "category": "Talkthrough",
        "icon": "$(list-ordered)"
      },
      {
        "command": "talkthrough.stopTour",
        "title": "Stop tour",
        "category": "Talkthrough",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "talkthrough",
          "title": "Talkthrough",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "talkthrough": [
        {
          "id": "talkthrough.player",
          "name": "Player",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Talkthrough",
      "properties": {
        "talkthrough.backend": {
          "type": "string",
          "enum": [
            "auto",
            "claude-cli",
            "anthropic-api"
          ],
          "enumDescriptions": [
            "Use whichever backend is ready, preferring a CLI you already installed.",
            "Use your own installed claude CLI. Talkthrough never installs it or handles your login.",
            "Call the Anthropic API with a key you store via \"Talkthrough: Set API key\"."
          ],
          "default": "auto",
          "markdownDescription": "Which backend generates the tour. `auto` prefers a signed-in CLI you already have, then falls back to an API key."
        },
        "talkthrough.baseRef": {
          "type": "string",
          "default": "",
          "markdownDescription": "Git ref that changes are compared against, for example `main` or `origin/main`. Leave empty to detect your default branch automatically. When your branch has no commits beyond the base, Talkthrough explains your uncommitted working-tree changes instead."
        },
        "talkthrough.openDiffView": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Open each segment as a diff against the base ref instead of the plain file."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "talkthrough.nextSegment",
          "when": "talkthrough.tourActive"
        },
        {
          "command": "talkthrough.previousSegment",
          "when": "talkthrough.tourActive"
        },
        {
          "command": "talkthrough.goToSegment",
          "when": "talkthrough.tourActive"
        },
        {
          "command": "talkthrough.stopTour",
          "when": "talkthrough.tourActive"
        }
      ],
      "editor/title": [
        {
          "command": "talkthrough.previousSegment",
          "when": "talkthrough.tourActive",
          "group": "navigation@1"
        },
        {
          "command": "talkthrough.goToSegment",
          "when": "talkthrough.tourActive",
          "group": "navigation@2"
        },
        {
          "command": "talkthrough.nextSegment",
          "when": "talkthrough.tourActive",
          "group": "navigation@3"
        },
        {
          "command": "talkthrough.stopTour",
          "when": "talkthrough.tourActive",
          "group": "navigation@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
